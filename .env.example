# Telegram Bot Token (從 @BotFather 獲取)
BOT_TOKEN=your_telegram_bot_token_here

# 啟動：python -m src.main_gemini
# Gemini parses text/images; OpenAI handles initial coaching and follow-ups.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PARSE_MODEL=gemini-2.5-flash
# /live lexical tokenizer; actor assignment is deterministic in live_flow.py
GEMINI_LIVE_PARSE_MODEL=gemini-3.6-flash
# Independent /live hands grade concurrently; clamped to 1-4.
LIVE_GRADE_WORKERS=3

# Missing OpenAI configuration degrades to an explicit deterministic/no-guess
# response; it never silently swaps narrators.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_COACH_MODEL=gpt-5.6-terra
OPENAI_COACH_REASONING_EFFORT=low
OPENAI_COACH_MAX_OUTPUT_TOKENS=900
OPENAI_COACH_MAX_TOOL_CALLS=4
OPENAI_COACH_MAX_EVIDENCE_ROUNDS=2

# 調試模式
DEBUG=true

# === Supabase / GTOW 自動同步 ===
SUPABASE_CONN=postgresql://postgres.project-ref:password@host:6543/postgres
SUPABASE_PASSWORD=your_supabase_database_password
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
SUPABASE_PROJECT_REF=ivtfzwsytdkdqolzxhkh
ADMIN_CHAT_ID=your_telegram_user_id

# Bot 與 Supabase Edge Function 必須使用完全相同的值（至少 32 字元）
# 生成方式：openssl rand -base64 48
GTOW_SYNC_PEPPER=replace_with_a_long_random_secret

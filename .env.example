# Telegram Bot Token (從 @BotFather 獲取)
BOT_TOKEN=your_telegram_bot_token_here

# === Gemini 模式 (推薦，快速) ===
# 使用 main_gemini.py 啟動
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# === Claude CLI 模式 (舊版) ===
# 使用 main.py 啟動
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_TIMEOUT=120

# 調試模式
DEBUG=true

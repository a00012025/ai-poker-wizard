# Telegram Bot Token (從 @BotFather 獲取)
BOT_TOKEN=your_telegram_bot_token_here

# Claude 模型 (可選，預設 sonnet)
# 可選值：sonnet, opus, haiku 或完整模型名
CLAUDE_MODEL=sonnet

# Claude 回應超時秒數 (可選，預設 120)
CLAUDE_TIMEOUT=120

# 瀏覽器設定 (GTO Wizard 自動化用，未來擴展)
HEADLESS_BROWSER=false
BROWSER_TIMEOUT=30000

# 調試模式
DEBUG=true

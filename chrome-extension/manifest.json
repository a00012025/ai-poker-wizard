{
  "manifest_version": 3,
  "name": "AI Poker Wizard - GTOW Sync",
  "version": "2.3.0",
  "description": "Securely pair with AI Poker Wizard, automatically sync your GTO Wizard token, and pull new hands into the ledger with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "host_permissions": [
    "https://app.gtowizard.com/*",
    "https://ivtfzwsytdkdqolzxhkh.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.gtowizard.com/*"],
      "js": ["page_session.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.gtowizard.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "AI Poker Wizard GTOW Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
